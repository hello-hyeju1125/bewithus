# =============================================================================
# Supabase
# -----------------------------------------------------------------------------
#   cp .env.local.example .env.local
#   실제 키/비밀번호는 절대 이 예제 파일에 넣지 마세요 (git 에 커밋됩니다).
# =============================================================================

# Project URL 만 입력 (끝에 /rest/v1 붙이지 마세요)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase 대시보드 → Project Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>
# ⚠️ service_role 키는 RLS 를 우회합니다. 절대 커밋/노출 금지, 서버 환경변수로만 설정.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>

# =============================================================================
# 관리자 로그인 (비밀번호만)
# -----------------------------------------------------------------------------
# ADMIN_PASSWORD: /admin/login 에서 입력하는 비밀번호 (길고 무작위하게)
# ADMIN_SESSION_SECRET: 세션 쿠키 서명키 — 반드시 anon 키와 다른 임의 문자열
#   생성 예: openssl rand -base64 48
# ADMIN_AUTHOR_ID: (공지 작성 시만 필요) Supabase Users 의 UUID
# =============================================================================

ADMIN_PASSWORD=<set-a-long-random-password>
ADMIN_SESSION_SECRET=<openssl-rand-base64-48>
ADMIN_AUTHOR_ID=<supabase-user-uuid>

# =============================================================================
# SEO (검색엔진 등록)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL: 배포 도메인 (끝 슬래시 없이). 예: https://www.example.com
# GOOGLE_SITE_VERIFICATION / NAVER_SITE_VERIFICATION / DAUM_SITE_VERIFICATION:
#   각 검색엔진 웹마스터 도구에서 발급한 소유권 확인 코드
# =============================================================================

NEXT_PUBLIC_SITE_URL=https://www.bewithus.kr
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
DAUM_SITE_VERIFICATION=
